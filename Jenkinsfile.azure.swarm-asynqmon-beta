pipeline {
    agent any

    environment {
        // Azure Blob Storage Credentials
        AZURE_STORAGE_ACCOUNT = 'likemindsstagingstorage'
        AZURE_STORAGE_CONTAINER = 'likeminds-staging-configs'
        BLOB_NAME = 'swarm-beta/swarm-beta-dot-env-private'
        DOWNLOAD_PATH = './cmd/server/config/.env'

        // Azure Container Registry Credentials
        ACR_NAME = 'likemindsstagingregistry'
        ACR_LOGIN_SERVER = 'likemindsstagingregistry.azurecr.io'
    }

    stages {
        stage("Checkout code") {
            steps {
                checkout scm
            }
         }
        
        stage('Login to Azure') {
            steps {
                withCredentials([string(credentialsId: 'likeminds-staging-service-principal-jenkins-credentials', variable: 'AZURE_CREDENTIALS')]) {          
                    sh '''
                        set +x
                        echo $AZURE_CREDENTIALS > azure_credentials.json
                        az login --service-principal -u "$(jq -r .clientId azure_credentials.json)" \
                                -p "$(jq -r .clientSecret azure_credentials.json)" \
                                --tenant "$(jq -r .tenantId azure_credentials.json)"
                        set -x
                        echo 'silent login to azure successful'
                    '''
                }
            }
        }

        stage('Download Env File from Azure Blob') {
            steps {
                sh '''
                    az storage blob download --account-name $AZURE_STORAGE_ACCOUNT \
                    --container-name $AZURE_STORAGE_CONTAINER \
                    --name $BLOB_NAME \
                    --file $DOWNLOAD_PATH \
                    --auth-mode login
                '''
            }
        }

        stage('Login to ACR') {
            steps {
                sh '''
                    set +x
                    docker login $ACR_LOGIN_SERVER -u "$(jq -r .clientId azure_credentials.json)" \
                    -p "$(jq -r .clientSecret azure_credentials.json)"
                    set -x
                    echo 'silent login to ACR successful'
                '''
            }
        }

        stage('Build Image') {
          steps {
              script {
                  // Read the .env file from the configured DOWNLOAD_PATH
                  def envContent = readFile(env.DOWNLOAD_PATH)
                  def envMap = [:]
                  envContent.split('\n').each {
                      def line = it.trim()
                      if (line && !line.startsWith('#') && line.contains('=')) {
                          def (key, value) = line.split('=', 2)
                          envMap[key.trim()] = value.trim()
                      }
                  }

                  // Extract required variables (dynamically)
                  def redisAddress = envMap['ASYNQ_BROKER_ADDRESS']
                  def redisPassword = envMap['ASYNQ_BROKER_PASSWORD']

                  // Echo only safe values (avoid printing passwords)
                  echo "Using Redis address: ${redisAddress}"

                  // Build the Docker image with dynamic build args
                  sh """
                    docker build \
                      --build-arg ASYNQ_BROKER_ADDRESS=${redisAddress} \
                      --build-arg ASYNQ_BROKER_PASSWORD=${redisPassword} \
                      -f Dockerfile.swarm-asynqmon-beta \
                      -t $ACR_LOGIN_SERVER/likeminds-swarm-asynqmon/swarm-asynqmon-staging:swarm-asynqmon-V$BUILD_NUMBER .
                  """
              }
          }
      }

        
        stage ('Push Asynqmon Image') {
          steps {
            sh '''
              docker push $ACR_LOGIN_SERVER/likeminds-swarm-asynqmon/swarm-asynqmon-staging:swarm-asynqmon-V$BUILD_NUMBER
            '''
          }
        }
        
        stage ("Update Tag and Push Helm Chart") {
          steps {
            script {
              // git branch: 'LM-13485-azure-migration', url: 'git@github.com:LikeMindsCommunity/LikeMinds-Infra-Config.git'
              git branch: 'change/LM-13849-adding_azure_swarm_asynqmon_staging_helm_chart', url: 'git@github.com:LikeMindsCommunity/LikeMinds-Infra-Config.git'
              sh 'sed -i "s/tag: swarm-asynqmon-V[0-9]*/tag: swarm-asynqmon-V${BUILD_NUMBER}/g" ./azure/staging/swarm-asynqmon-beta/values.yaml'
              sh "git add ./azure/staging/swarm-asynqmon-beta/values.yaml"
              sh 'git commit -m "Update Asynqmon Beta Image Tag"'
              sh "git push origin change/LM-13849-adding_azure_swarm_asynqmon_staging_helm_chart"
            }
          }
        }

    }
}
